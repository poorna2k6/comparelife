# Copy to .env. Everything is optional in development.
NODE_ENV=production
PORT=3000
APP_URL=https://fitpot.example.com     # required in production (used in emails)
DB_PATH=/data/fitpot.db
TRUST_PROXY=true                       # true when behind a load balancer / reverse proxy
# COOKIE_SECURE defaults to true in production (needs HTTPS)
SESSION_DAYS=30
# Compliance switch. Keep false until legal sign-off (see docs/LAUNCH.md): entry fees are forced to 0.
ALLOW_REAL_MONEY=false
MAX_STAKE_MINOR=1000000                # per-person cap in minor units (paise/cents)
MIN_PARTICIPANTS=2
LOG_LEVEL=info
